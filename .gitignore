# AstraRun .gitignore

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/*.log
*.log

# Local telemetry, usage, and evaluation data
data/*
!data/training/
!data/training/**
*.jsonl
benchmarks/routing/cache/

# Build artifacts & package distribution
build/
dist/
*.egg-info/
*.spec
!packaging/AstraRun.spec

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Scratch & temporary verification files
scratch/


# Local coding-agent state
.mimocode/

# Runtime and physical-test outputs
outputs/

# Local milestone prompt captures
f0_*_prompt.txt

# Ad-hoc frozen-product verification output
test1_frozen_result.json

# Historical/local PyInstaller phase build directories
build_f0*/
build_f025f1/

# Local audit databases
docs/audit/*.db

# Python/PyInstaller generated package intermediates
*.pkg
*.pyz

# Generated workstation-agent dogfood projects
projects/

# Ad-hoc one-off diagnostic helpers
scripts/detail_*.py
scripts/dump_details.py
scripts/inspect_*.py
scripts/print_all.py
scripts/print_msgs.py
