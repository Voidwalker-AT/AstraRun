# AstraRun .gitignore

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/*.log
*.log

# Local telemetry, usage, and evaluation data
data/*
!data/training/
!data/training/**
*.jsonl
benchmarks/routing/cache/

# Build artifacts & package distribution
build/
dist/
*.egg-info/
*.spec
!packaging/AstraRun.spec

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Scratch & temporary verification files
scratch/

