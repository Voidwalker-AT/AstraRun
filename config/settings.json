{
  "hotkey": {
    "modifiers": ["Alt"],
    "key": "Space"
  },
  "ui": {
    "width": 640,
    "height": 56,
    "theme": "dark",
    "placeholder": "What do you want to do?",
    "hide_on_focus_loss": true,
    "opacity": 0.98,
    "max_suggestions": 5
  },
  "telemetry": {
    "enabled": true,
    "file": "data/routing_events.jsonl",
    "store_raw_request": true
  },
  "shadow_models": {
    "laya": true,
    "kev": false
  },
  "laya": {
    "enabled": true,
    "mode": "shadow",
    "model": "convaiinnovations/laya",
    "device": "cpu",
    "confidence_threshold": 0.75,
    "shadow_file": "data/laya_shadow_events.jsonl"
  },
  "kev": {
    "enabled": false,
    "mode": "shadow",
    "model": "jaredpalmer/kev-0.8b",
    "base_model": "Qwen/Qwen3.5-0.8B-Base",
    "device": "cpu",
    "confidence_threshold": 0.75,
    "shadow_file": "data/kev_shadow_events.jsonl"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/astrarun.log",
    "max_bytes": 10485760,
    "backup_count": 3
  },
  "history": {
    "enabled": true,
    "db_path": "data/astra_history.db",
    "store_raw_requests": true,
    "retention_days": 30,
    "max_tasks": 5000,
    "store_result_payloads": false
  }
}
